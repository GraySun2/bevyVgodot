; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Farm"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.164706, 0.101961, 0.078431, 1)
boot_splash/show_image=false

[autoload]

Sheet="*res://sheet.gd"

[display]

; The size of the upright picture: 9 by 18 tiles of 32 pixels. main.gd fits it to the screen.
window/size/viewport_width=288
window/size/viewport_height=576

[input_devices]

; Fingers and the mouse both arrive as touches (a mouse press is touch 0), so the
; game handles one kind of input and each finger keeps its own number.
pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.164706, 0.101961, 0.078431, 1)
